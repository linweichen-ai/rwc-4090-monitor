[Unit]
Description=GPU dashboard collector for %i
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
EnvironmentFile=%h/.config/gpu-dashboard/%i.env
ExecStart=/usr/bin/python3 %h/.local/lib/gpu-dashboard/gpu_dashboard_collector.py --node %i --interval 30
Restart=always
RestartSec=10
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=%h/.local/state/gpu-dashboard

[Install]
WantedBy=default.target

